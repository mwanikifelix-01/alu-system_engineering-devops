#!/usr/bin/env bash
# Install HAProxy, configure it to load-balance traffic between web-01 and web-02 using roundrobin

apt-get update -y
apt-get install -y haproxy

# Update haproxy configuration to include web-01 and web-02 with roundrobin
cat << 'EOF' >> /etc/haproxy/haproxy.cfg

frontend hbs_frontend
    bind *:80
    default_backend hbs_backend

backend hbs_backend
    balance roundrobin
    server web-01 3.9.17.146:80 check
    server web-02 18.130.224.177:80 check
EOF

# Restart/start HAProxy via init script
service haproxy restart
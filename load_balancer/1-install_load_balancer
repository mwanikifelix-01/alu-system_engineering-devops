#!/usr/bin/env bash
# Installs HAProxy on lb-01 and balances traffic to web-01 and web-02
sudo apt-get update -y
sudo apt-get install -y haproxy
if ! grep -q "http_back" /etc/haproxy/haproxy.cfg; then
sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null <<EOF

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7425-web-01 3.9.17.146:80 check
    server 7425-web-02 18.130.224.177:80 check
EOF
fi
sudo service haproxy restart
#!/usr/bin/env bash
# Configure Nginx with a custom HTTP header X-Served-By containing the server's hostname
# shellcheck disable=SC2154

# Update and install Nginx
apt-get update -y
apt-get install -y nginx

# Insert add_header directive into the default server block if it doesn't already exist
if ! grep -q "add_header X-Served-By" /etc/nginx/sites-available/default; then
    sed -i '/server_name _;/a \    add_header X-Served-By $hostname;' /etc/nginx/sites-available/default
fi

# Test Nginx configuration and restart the service
nginx -t
service nginx restart
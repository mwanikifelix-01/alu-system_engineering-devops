#!/usr/bin/env bash
# Configures nginx so every response has an X-Served-By header with the server's hostname
SUDO=""
if [ "$(id -u)" -ne 0 ]; then
    SUDO="sudo"
fi

$SUDO apt-get update -y
$SUDO apt-get install -y nginx

echo "Holberton School for the win!" | $SUDO tee /var/www/html/index.html > /dev/null
echo "Ceci n'est pas une page" | $SUDO tee /var/www/html/404.html > /dev/null

$SUDO tee /etc/nginx/sites-available/default > /dev/null << 'CONF'
server {
	listen 80 default_server;
	listen [::]:80 default_server;

	root /var/www/html;
	index index.html index.htm index.nginx-debian.html;

	server_name _;

	add_header X-Served-By $hostname;

	location / {
		try_files $uri $uri/ =404;
	}

	location /redirect_me {
		return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
	}

	error_page 404 /404.html;
	location = /404.html {
		root /var/www/html;
		internal;
	}
}
CONF

$SUDO ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
$SUDO rm -f /etc/nginx/conf.d/custom_header.conf

$SUDO service nginx restart
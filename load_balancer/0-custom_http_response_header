#!/usr/bin/env bash
# Configures nginx so every response has an X-Served-By header with the server's hostname
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html

config="/etc/nginx/sites-available/default"
redirect="\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}"
if ! grep -q "redirect_me" "$config"; then
    sed -i "/server_name _;/a \\$redirect" "$config"
fi

not_found="\terror_page 404 /404.html;\n\tlocation = /404.html {\n\t\troot /var/www/html;\n\t\tinternal;\n\t}"
if ! grep -q "error_page 404" "$config"; then
    sed -i "/server_name _;/a \\$not_found" "$config"
fi

if ! grep -q "X-Served-By" "$config"; then
    sed -i "/server_name _;/a \\\\tadd_header X-Served-By \$hostname;" "$config"
fi

service nginx restart
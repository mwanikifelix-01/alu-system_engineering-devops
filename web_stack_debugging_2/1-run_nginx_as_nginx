#!/usr/bin/env bash
# Configures nginx to run as the nginx user and listen on all active IPs on port 8080
pkill apache2
chmod 644 /etc/nginx/nginx.conf
sed -i "s/#\?\s*user .*;/user nginx;/" /etc/nginx/nginx.conf
sed -i "s/listen 80 /listen 8080 /; s/listen \[::\]:80 /listen [::]:8080 /" /etc/nginx/sites-available/default
su nginx -s /bin/bash -c "service nginx restart"